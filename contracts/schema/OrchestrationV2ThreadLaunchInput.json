{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OrchestrationV2ThreadLaunchInput",
  "title": "OrchestrationV2ThreadLaunchInput",
  "type": "object",
  "properties": {
    "commandId": {
      "type": "string"
    },
    "creationSource": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "web",
            "mobile",
            "mcp",
            "provider",
            "server"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reuseExistingThread": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "projectId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "generateTitle": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "modelSelection": {
      "$ref": "#/$defs/ModelSelection"
    },
    "runtimeMode": {
      "type": "string",
      "enum": [
        "approval-required",
        "auto-accept-edits",
        "auto",
        "full-access"
      ]
    },
    "interactionMode": {
      "type": "string",
      "enum": [
        "default",
        "plan"
      ]
    },
    "workspaceStrategy": {
      "$ref": "#/$defs/OrchestrationV2ThreadLaunchWorkspaceStrategy"
    },
    "initialMessage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "messageId": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "context": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OrchestrationMessageContext"
                },
                {
                  "type": "null"
                }
              ]
            },
            "attachments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChatAttachment"
              }
            }
          },
          "required": [
            "text",
            "attachments"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "commandId",
    "projectId",
    "title",
    "modelSelection",
    "runtimeMode",
    "interactionMode",
    "workspaceStrategy"
  ],
  "additionalProperties": true,
  "$defs": {
    "AssetImageDimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "ChatAttachment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatImageAttachment"
        },
        {
          "$ref": "#/$defs/ChatFileAttachment"
        },
        {
          "$ref": "#/$defs/ChatUnknownAttachment"
        }
      ]
    },
    "ChatFileAttachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PastedTextAttachmentSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "additionalProperties": true
    },
    "ChatImageAttachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapShotSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "additionalProperties": true
    },
    "ChatUnknownAttachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "additionalProperties": true
    },
    "ModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "instanceId": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "model": {},
        "options": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": true
    },
    "OrchestrationMessageContext": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "enum": [
            1
          ]
        },
        "records": {
          "type": "array",
          "maxItems": 200
        }
      },
      "required": [
        "version",
        "records"
      ],
      "additionalProperties": true
    },
    "OrchestrationV2ThreadLaunchWorkspaceStrategy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "root"
              ]
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "existing_worktree"
              ]
            },
            "worktreePath": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "worktreePath"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "worktree"
              ]
            },
            "baseRef": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startFromOrigin": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "baseRef"
          ],
          "additionalProperties": true
        }
      ]
    },
    "PastedTextAttachmentSource": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": [
            "pasted-text"
          ]
        }
      },
      "required": [
        "_tag"
      ],
      "additionalProperties": true
    },
    "SnapShotAccessibility": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "flat-text"
              ]
            },
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "format",
            "text",
            "truncated"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "element-tree"
              ]
            },
            "coordinateSpace": {
              "type": "string",
              "enum": [
                "captured-image"
              ]
            },
            "imageSize": {
              "$ref": "#/$defs/AssetImageDimensions"
            },
            "truncated": {
              "type": "boolean"
            },
            "root": {
              "$ref": "#/$defs/SnapShotAccessibilityNode"
            }
          },
          "required": [
            "format",
            "coordinateSpace",
            "imageSize",
            "truncated",
            "root"
          ],
          "additionalProperties": true
        }
      ]
    },
    "SnapShotAccessibilityNode": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bounds": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "object",
          "properties": {
            "active": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "busy": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "on",
                    "off",
                    "mixed"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "editable": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expanded": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "focused": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "selected": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "visible": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapShotAccessibilityNode"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "role",
        "bounds",
        "children"
      ],
      "additionalProperties": true
    },
    "SnapShotSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "snap-shot"
          ]
        },
        "capturedAt": {
          "type": "string"
        },
        "appName": {
          "type": "string"
        },
        "windowTitle": {
          "type": "string"
        },
        "accessibleText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapShotAccessibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "appIdentifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "appIconDataUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "capturedAt",
        "appName",
        "windowTitle"
      ],
      "additionalProperties": true
    }
  }
}
