{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VcsListRefsInput",
  "title": "VcsListRefsInput",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string"
    },
    "query": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "cursor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "includeMatchingRemoteRefs": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "refKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "all",
            "local",
            "remote"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "refresh": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "cwd"
  ],
  "additionalProperties": true
}
