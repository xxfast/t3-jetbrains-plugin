{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PreviewListResult",
  "title": "PreviewListResult",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PreviewSessionSnapshot"
      }
    },
    "serverEpoch": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "sessions",
    "serverEpoch",
    "revision"
  ],
  "additionalProperties": true,
  "$defs": {
    "PreviewNavStatus": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "Idle"
              ]
            }
          },
          "required": [
            "_tag"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "Loading"
              ]
            },
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "_tag",
            "url",
            "title"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "Success"
              ]
            },
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "_tag",
            "url",
            "title"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "LoadFailed"
              ]
            },
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string",
              "maxLength": 512
            },
            "code": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "description": {
              "type": "string"
            },
            "download": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "fileName": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "fileName"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "_tag",
            "url",
            "title",
            "code",
            "description"
          ],
          "additionalProperties": true
        }
      ]
    },
    "PreviewSessionSnapshot": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "tabId": {
          "type": "string"
        },
        "navStatus": {
          "$ref": "#/$defs/PreviewNavStatus"
        },
        "canGoBack": {
          "type": "boolean"
        },
        "canGoForward": {
          "type": "boolean"
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/PreviewViewportSetting"
            },
            {
              "type": "null"
            }
          ]
        },
        "colorScheme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "zoomFactor": {
          "anyOf": [
            {
              "type": "number",
              "enum": [
                0.25,
                0.33,
                0.5,
                0.67,
                0.75,
                0.8,
                0.9,
                1,
                1.1,
                1.25,
                1.5,
                1.75,
                2,
                2.5,
                3,
                4,
                5
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "profileId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "desktop",
                "server"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "headless": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "automationOwner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reveal": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "revealRequest": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "force": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "force"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "tabId",
        "navStatus",
        "canGoBack",
        "canGoForward",
        "updatedAt"
      ],
      "additionalProperties": true
    },
    "PreviewViewportSetting": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "fill"
              ]
            }
          },
          "required": [
            "_tag"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "freeform"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 240,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 240,
              "maximum": 3840
            }
          },
          "required": [
            "_tag",
            "width",
            "height"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "preset"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 240,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 240,
              "maximum": 3840
            },
            "presetId": {
              "type": "string",
              "enum": [
                "iphone-se",
                "iphone-xr",
                "iphone-12-pro",
                "iphone-14-pro-max",
                "pixel-7",
                "samsung-galaxy-s8-plus",
                "samsung-galaxy-s20-ultra",
                "ipad-mini",
                "ipad-air",
                "ipad-pro",
                "surface-pro-7",
                "surface-duo",
                "galaxy-z-fold-5",
                "asus-zenbook-fold",
                "samsung-galaxy-a51-71",
                "nest-hub",
                "nest-hub-max",
                "desktop-1920x1080",
                "desktop-1440x900",
                "laptop-1366x768",
                "laptop-1280x800",
                "ipad-pro-11",
                "iphone-15-pro",
                "pixel-8",
                "galaxy-s24"
              ]
            }
          },
          "required": [
            "_tag",
            "width",
            "height",
            "presetId"
          ],
          "additionalProperties": true
        }
      ]
    }
  }
}
