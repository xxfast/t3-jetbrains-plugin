{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProjectSearchEntriesResult",
  "title": "ProjectSearchEntriesResult",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProjectEntry"
      }
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "entries",
    "truncated"
  ],
  "additionalProperties": true,
  "$defs": {
    "ProjectEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "directory"
          ]
        },
        "ignored": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "additionalProperties": true
    }
  }
}
