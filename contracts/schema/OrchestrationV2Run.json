{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OrchestrationV2Run",
  "title": "OrchestrationV2Run",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "providerInstanceId": {
      "type": "string"
    },
    "modelSelection": {
      "$ref": "#/$defs/ModelSelection"
    },
    "providerThreadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "userMessageId": {
      "type": "string"
    },
    "rootNodeId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeAttemptId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "queued",
        "starting",
        "running",
        "waiting",
        "completed",
        "interrupted",
        "failed",
        "cancelled",
        "rolled_back"
      ]
    },
    "queuePosition": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "queueHeld": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "requestedAt": {
      "type": "string"
    },
    "startedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpointId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "contextHandoffId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "restartContinuationOfRunId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "delegatedTaskId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workStartedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "restartCancelledBackgroundWork": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrchestrationV2RestartCancelledBackgroundWork"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sourcePlanRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "threadId": {
              "type": "string"
            },
            "planId": {
              "type": "string"
            }
          },
          "required": [
            "threadId",
            "planId"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "delegatedCompletion": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrchestrationV2DelegatedCompletionCohort"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspacePreparation": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrchestrationV2ThreadLaunchWorkspaceStrategy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "threadId",
    "ordinal",
    "providerInstanceId",
    "modelSelection",
    "providerThreadId",
    "userMessageId",
    "rootNodeId",
    "activeAttemptId",
    "status",
    "requestedAt",
    "startedAt",
    "completedAt",
    "checkpointId",
    "contextHandoffId"
  ],
  "additionalProperties": true,
  "$defs": {
    "ModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "instanceId": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "model": {},
        "options": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": true
    },
    "OrchestrationV2DelegatedCompletionCohort": {
      "type": "object",
      "properties": {
        "disposition": {
          "type": "string",
          "enum": [
            "open",
            "stopped",
            "disposed"
          ]
        },
        "nextGeneration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "delivery": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrchestrationV2DelegatedCompletionDelivery"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "disposition",
        "nextGeneration",
        "delivery"
      ],
      "additionalProperties": true
    },
    "OrchestrationV2DelegatedCompletionDelivery": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "messageId": {
          "type": "string"
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "generation",
        "messageId",
        "taskIds"
      ],
      "additionalProperties": true
    },
    "OrchestrationV2RestartCancelledBackgroundWork": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "subagent",
            "shell",
            "monitor",
            "task"
          ]
        },
        "label": {
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "label"
      ],
      "additionalProperties": true
    },
    "OrchestrationV2ThreadLaunchWorkspaceStrategy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "root"
              ]
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "existing_worktree"
              ]
            },
            "worktreePath": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "worktreePath"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "worktree"
              ]
            },
            "baseRef": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startFromOrigin": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "baseRef"
          ],
          "additionalProperties": true
        }
      ]
    }
  }
}
