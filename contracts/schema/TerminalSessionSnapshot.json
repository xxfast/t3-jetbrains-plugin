{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TerminalSessionSnapshot",
  "title": "TerminalSessionSnapshot",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1
    },
    "terminalId": {
      "type": "string",
      "minLength": 1
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "worktreePath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "starting",
        "running",
        "exited",
        "error"
      ]
    },
    "pid": {
      "anyOf": [
        {
          "type": "integer",
          "maximum": 9007199254740991,
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "history": {
      "type": "string"
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "exitSignal": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "type": "string",
      "maxLength": 128
    },
    "updatedAt": {
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "threadId",
    "terminalId",
    "cwd",
    "worktreePath",
    "status",
    "pid",
    "history",
    "exitCode",
    "exitSignal",
    "label",
    "updatedAt"
  ],
  "additionalProperties": true
}
