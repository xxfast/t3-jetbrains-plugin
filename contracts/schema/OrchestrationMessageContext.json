{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OrchestrationMessageContext",
  "title": "OrchestrationMessageContext",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "enum": [
        1
      ]
    },
    "guest": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuestMessageAttribution"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "type": "array",
      "maxItems": 200
    }
  },
  "required": [
    "version",
    "records"
  ],
  "additionalProperties": true,
  "$defs": {
    "GuestMessageAttribution": {
      "type": "object",
      "properties": {
        "guestMessageId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "shareId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "guestMessageId",
        "name",
        "text"
      ],
      "additionalProperties": true
    }
  }
}
