{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ScheduledTask",
  "title": "ScheduledTask",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "schedule": {
      "$ref": "#/$defs/ScheduledTaskSchedule"
    },
    "projectId": {
      "type": "string"
    },
    "threadId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceStrategy": {
      "$ref": "#/$defs/OrchestrationV2ThreadLaunchWorkspaceStrategy"
    },
    "modelSelection": {
      "$ref": "#/$defs/ModelSelection"
    },
    "runtimeMode": {
      "type": "string",
      "enum": [
        "approval-required",
        "auto-accept-edits",
        "auto",
        "full-access"
      ]
    },
    "interactionMode": {
      "type": "string",
      "enum": [
        "default",
        "plan"
      ]
    },
    "createdBy": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "system"
      ]
    },
    "creationSource": {
      "type": "string",
      "enum": [
        "web",
        "mobile",
        "mcp",
        "provider",
        "server"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "nextRunAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastRunAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastRunStatus": {
      "type": "string",
      "enum": [
        "never",
        "running",
        "succeeded",
        "failed"
      ]
    },
    "lastRunError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "runCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "webhook": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScheduledTaskWebhookEndpoint"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "prompt",
    "enabled",
    "schedule",
    "projectId",
    "threadId",
    "workspaceStrategy",
    "modelSelection",
    "runtimeMode",
    "interactionMode",
    "createdBy",
    "creationSource",
    "createdAt",
    "updatedAt",
    "nextRunAt",
    "lastRunAt",
    "lastRunStatus",
    "lastRunError",
    "runCount"
  ],
  "additionalProperties": true,
  "$defs": {
    "ModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "instanceId": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "model": {},
        "options": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": true
    },
    "OrchestrationV2ThreadLaunchWorkspaceStrategy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "root"
              ]
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "existing_worktree"
              ]
            },
            "worktreePath": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "worktreePath"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "worktree"
              ]
            },
            "baseRef": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startFromOrigin": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "baseRef"
          ],
          "additionalProperties": true
        }
      ]
    },
    "ScheduledTaskSchedule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "interval"
              ]
            },
            "everyMs": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "type",
            "everyMs"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "fixed_time"
              ]
            },
            "timeOfDay": {
              "type": "string"
            },
            "weekdays": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6,
                    "description": "Weekday. 0 is Sunday, 6 is Saturday."
                  },
                  "description": "Default: every day."
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "timeOfDay"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "webhook"
              ]
            },
            "signature": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScheduledTaskWebhookSignature"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxDeliveryAgeMinutes": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1440,
                      "description": "Skip requests held offline over this many minutes. Omit to run all."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "dedupe": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "replayKey": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "coalesceKey": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "coalesceWindowSeconds": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 10,
                          "maximum": 3600
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": true,
                  "description": "Replay and coalesce key templates. Window in seconds, default 120."
                },
                {
                  "type": "null"
                }
              ]
            },
            "filters": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ScheduledTaskWebhookFilter"
                  },
                  "maxItems": 16,
                  "description": "All must match. Max 16. Omitted: keep stored. [] clears."
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "signature"
          ],
          "additionalProperties": true,
          "description": "Run on each webhook request."
        }
      ]
    },
    "ScheduledTaskWebhookEndpoint": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasSecret": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "url",
        "hasSecret"
      ],
      "additionalProperties": true
    },
    "ScheduledTaskWebhookFilter": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "equals",
                "notEquals",
                "startsWith"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "op",
            "value"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "in"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Non-empty, without commas or surrounding whitespace."
              },
              "minItems": 1
            }
          },
          "required": [
            "path",
            "op",
            "value"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "exists"
              ]
            }
          },
          "required": [
            "path",
            "op"
          ],
          "additionalProperties": true
        }
      ],
      "description": "Path: `headers.x-event` or `body.action`. String compare. Objects pass only 'exists'. A `[]` segment matches any array item. `notEquals` passes only if no item equals."
    },
    "ScheduledTaskWebhookSignature": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "hex",
            "base64"
          ]
        },
        "prefix": {
          "type": "string",
          "description": "Text before the digest, such as 'sha256='. Empty for none."
        }
      },
      "required": [
        "header",
        "encoding",
        "prefix"
      ],
      "additionalProperties": true,
      "description": "HMAC-SHA256 check on the raw body."
    }
  }
}
