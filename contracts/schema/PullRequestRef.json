{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PullRequestRef",
  "title": "PullRequestRef",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string"
    },
    "host": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "expectedAccountId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowStale": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "repository": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "projectId",
    "repository",
    "number"
  ],
  "additionalProperties": true
}
