{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ScheduledTaskMutationResult",
  "title": "ScheduledTaskMutationResult",
  "type": "object",
  "properties": {
    "task": {
      "$ref": "#/$defs/ScheduledTask"
    }
  },
  "required": [
    "task"
  ],
  "additionalProperties": true,
  "$defs": {
    "ModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "instanceId": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "model": {},
        "options": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": true
    },
    "OrchestrationV2ThreadLaunchWorkspaceStrategy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "root"
              ]
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "existing_worktree"
              ]
            },
            "worktreePath": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "worktreePath"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "worktree"
              ]
            },
            "baseRef": {
              "type": "string"
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "startFromOrigin": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "baseRef"
          ],
          "additionalProperties": true
        }
      ]
    },
    "ScheduledTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduledTaskSchedule"
        },
        "projectId": {
          "type": "string"
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceStrategy": {
          "$ref": "#/$defs/OrchestrationV2ThreadLaunchWorkspaceStrategy"
        },
        "modelSelection": {
          "$ref": "#/$defs/ModelSelection"
        },
        "runtimeMode": {
          "type": "string",
          "enum": [
            "approval-required",
            "auto-accept-edits",
            "auto",
            "full-access"
          ]
        },
        "interactionMode": {
          "type": "string",
          "enum": [
            "default",
            "plan"
          ]
        },
        "createdBy": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "system"
          ]
        },
        "creationSource": {
          "type": "string",
          "enum": [
            "web",
            "mobile",
            "mcp",
            "provider",
            "server"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "nextRunAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastRunAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastRunStatus": {
          "type": "string",
          "enum": [
            "never",
            "running",
            "succeeded",
            "failed"
          ]
        },
        "lastRunError": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "runCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "webhook": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduledTaskWebhookEndpoint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "prompt",
        "enabled",
        "schedule",
        "projectId",
        "threadId",
        "workspaceStrategy",
        "modelSelection",
        "runtimeMode",
        "interactionMode",
        "createdBy",
        "creationSource",
        "createdAt",
        "updatedAt",
        "nextRunAt",
        "lastRunAt",
        "lastRunStatus",
        "lastRunError",
        "runCount"
      ],
      "additionalProperties": true
    },
    "ScheduledTaskSchedule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "interval"
              ],
              "description": "Select interval scheduling."
            },
            "everyMs": {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0,
              "description": "Positive interval in milliseconds."
            }
          },
          "required": [
            "type",
            "everyMs"
          ],
          "additionalProperties": true,
          "description": "Run repeatedly after a fixed number of milliseconds."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "fixed_time"
              ],
              "description": "Select a fixed local wall-clock time."
            },
            "timeOfDay": {
              "type": "string"
            },
            "weekdays": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6,
                    "description": "Weekday number where 0 is Sunday and 6 is Saturday."
                  },
                  "description": "Optional weekdays; omit to run every day."
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "timeOfDay"
          ],
          "additionalProperties": true,
          "description": "Run at a fixed local wall-clock time on selected weekdays."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "webhook"
              ],
              "description": "Run when the task's webhook URL receives a request."
            },
            "signature": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ScheduledTaskWebhookSignature"
                },
                {
                  "type": "null"
                }
              ]
            },
            "maxDeliveryAgeMinutes": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1440,
                      "description": "Skip requests the relay held longer than this many minutes while the environment was offline. Null runs every request."
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "dedupe": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "replayKey": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "coalesceKey": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "coalesceWindowSeconds": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 10,
                          "maximum": 3600
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": true,
                  "description": "Replay key template (7 days), coalesce key template, and fixed window in seconds (default 120)."
                },
                {
                  "type": "null"
                }
              ]
            },
            "filters": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ScheduledTaskWebhookFilter"
                  },
                  "maxItems": 16,
                  "description": "Run only when every filter matches the request; other requests are logged as filtered. Up to 16. Omit to keep the stored filters; pass [] to clear them."
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "signature"
          ],
          "additionalProperties": true,
          "description": "Run on each request to the task's webhook URL. The prompt may use {{body.path}}, {{headers.name}}, {{query.name}}, {{body}} and {{request}} placeholders."
        }
      ],
      "description": "Structured trigger. Pass an object with type 'interval', 'fixed_time' or 'webhook'."
    },
    "ScheduledTaskWebhookEndpoint": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "hasSecret": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "url",
        "hasSecret"
      ],
      "additionalProperties": true
    },
    "ScheduledTaskWebhookFilter": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "equals",
                "notEquals",
                "startsWith"
              ]
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "op",
            "value"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "in"
              ]
            },
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Non-empty, without commas or surrounding whitespace."
              },
              "minItems": 1
            }
          },
          "required": [
            "path",
            "op",
            "value"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "enum": [
                "exists"
              ]
            }
          },
          "required": [
            "path",
            "op"
          ],
          "additionalProperties": true
        }
      ],
      "description": "Scalars compare as strings; objects and arrays only satisfy 'exists'. Every op but 'exists' fails when the path is missing. A [] wildcard path yields a list: equals, in and startsWith match when any element does, notEquals when no element equals the value, exists when the list is not empty."
    },
    "ScheduledTaskWebhookSignature": {
      "type": "object",
      "properties": {
        "header": {
          "type": "string"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "hex",
            "base64"
          ],
          "description": "How the HMAC-SHA256 digest is encoded in the header."
        },
        "prefix": {
          "type": "string",
          "description": "Text before the digest in the header value, such as 'sha256='. Empty for none."
        }
      },
      "required": [
        "header",
        "encoding",
        "prefix"
      ],
      "additionalProperties": true,
      "description": "Optional HMAC-SHA256 signature check over the raw request body."
    }
  }
}
