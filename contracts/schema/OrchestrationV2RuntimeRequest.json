{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OrchestrationV2RuntimeRequest",
  "title": "OrchestrationV2RuntimeRequest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "nodeId": {
      "type": "string"
    },
    "providerTurnId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "nativeRequestRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/OrchestrationV2ProviderRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "command",
        "file-read",
        "file-change",
        "mcp-elicitation",
        "permission",
        "dynamic_tool_call",
        "user_input",
        "auth_refresh"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "expired",
        "cancelled"
      ]
    },
    "responseCapability": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "live"
              ]
            },
            "providerSessionId": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "providerSessionId"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "message"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "not_resumable"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "reason"
          ],
          "additionalProperties": true
        }
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "resolvedAt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "accept",
            "acceptForSession",
            "acceptAlways",
            "decline",
            "cancel"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "answers": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "nodeId",
    "providerTurnId",
    "nativeRequestRef",
    "kind",
    "status",
    "responseCapability",
    "createdAt",
    "resolvedAt"
  ],
  "additionalProperties": true,
  "$defs": {
    "OrchestrationV2ProviderRef": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string"
        },
        "nativeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "strength": {
          "type": "string",
          "enum": [
            "strong",
            "weak",
            "none"
          ]
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ordinal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "driver",
        "nativeId",
        "strength"
      ],
      "additionalProperties": true
    }
  }
}
