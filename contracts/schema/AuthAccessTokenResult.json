{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AuthAccessTokenResult",
  "title": "AuthAccessTokenResult",
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "issued_token_type": {
      "type": "string",
      "enum": [
        "urn:ietf:params:oauth:token-type:access_token"
      ]
    },
    "token_type": {
      "type": "string",
      "enum": [
        "Bearer",
        "DPoP"
      ]
    },
    "expires_in": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "Infinity",
            "-Infinity",
            "NaN"
          ]
        }
      ]
    },
    "scope": {
      "type": "string"
    }
  },
  "required": [
    "access_token",
    "issued_token_type",
    "token_type",
    "expires_in",
    "scope"
  ],
  "additionalProperties": true
}
