{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TerminalAttachInput",
  "title": "TerminalAttachInput",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string"
    },
    "terminalId": {
      "type": "string"
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "worktreePath": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "cols": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "env": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "maxProperties": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "providerInstanceId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "restartIfNotRunning": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "resume": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "threadId",
    "terminalId"
  ],
  "additionalProperties": true
}
