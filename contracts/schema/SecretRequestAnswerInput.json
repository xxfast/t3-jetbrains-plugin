{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SecretRequestAnswerInput",
  "title": "SecretRequestAnswerInput",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string"
    },
    "turnItemId": {
      "type": "string"
    },
    "answer": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "save"
              ]
            },
            "secret": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "secret"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "decline"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        }
      ]
    }
  },
  "required": [
    "threadId",
    "turnItemId",
    "answer"
  ],
  "additionalProperties": true
}
