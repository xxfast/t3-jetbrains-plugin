{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProjectMutation",
  "title": "ProjectMutation",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "project.create"
          ]
        },
        "commandId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "workspaceRoot": {
          "type": "string"
        },
        "createWorkspaceRootIfMissing": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaultModelSelection": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelSelection"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scripts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProjectScript"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "commandId",
        "projectId",
        "title",
        "workspaceRoot"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "project.update"
          ]
        },
        "commandId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceRoot": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaultModelSelection": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelSelection"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "autoPull": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "projectIcon": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProjectIconOverride"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "faviconPath": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "defaultThreadEnvMode": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "local",
                    "worktree"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scripts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ProjectScript"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "commandId",
        "projectId"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "project.delete"
          ]
        },
        "commandId": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "force": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "commandId",
        "projectId"
      ],
      "additionalProperties": true
    }
  ],
  "$defs": {
    "ModelSelection": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "instanceId": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "model": {},
        "options": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": true
    },
    "ProjectIconOverride": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "lucide"
              ]
            },
            "name": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "enum": [
                "gray",
                "red",
                "orange",
                "amber",
                "yellow",
                "lime",
                "green",
                "emerald",
                "teal",
                "cyan",
                "sky",
                "blue",
                "indigo",
                "violet",
                "purple",
                "fuchsia",
                "pink",
                "rose"
              ]
            }
          },
          "required": [
            "kind",
            "name",
            "color"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "emoji"
              ]
            },
            "emoji": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "emoji"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "monogram"
              ]
            },
            "text": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "enum": [
                "gray",
                "red",
                "orange",
                "amber",
                "yellow",
                "lime",
                "green",
                "emerald",
                "teal",
                "cyan",
                "sky",
                "blue",
                "indigo",
                "violet",
                "purple",
                "fuchsia",
                "pink",
                "rose"
              ]
            }
          },
          "required": [
            "kind",
            "text",
            "color"
          ],
          "additionalProperties": true
        }
      ]
    },
    "ProjectScript": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "enum": [
            "play",
            "test",
            "lint",
            "configure",
            "build",
            "debug"
          ]
        },
        "runOnWorktreeCreate": {
          "type": "boolean"
        },
        "runOnSettle": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "async": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "previewUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "autoOpenPreview": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "command",
        "icon",
        "runOnWorktreeCreate"
      ],
      "additionalProperties": true
    }
  }
}
