{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PersistChatAttachmentsResult",
  "title": "PersistChatAttachmentsResult",
  "type": "object",
  "properties": {
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChatAttachment"
      }
    }
  },
  "required": [
    "attachments"
  ],
  "additionalProperties": true,
  "$defs": {
    "AssetImageDimensions": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": true
    },
    "ChatAttachment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatImageAttachment"
        },
        {
          "$ref": "#/$defs/ChatFileAttachment"
        },
        {
          "$ref": "#/$defs/ChatUnknownAttachment"
        }
      ]
    },
    "ChatFileAttachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/PastedTextAttachmentSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "additionalProperties": true
    },
    "ChatImageAttachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "image"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapShotSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "additionalProperties": true
    },
    "ChatUnknownAttachment": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "mimeType",
        "sizeBytes"
      ],
      "additionalProperties": true
    },
    "PastedTextAttachmentSource": {
      "type": "object",
      "properties": {
        "_tag": {
          "type": "string",
          "enum": [
            "pasted-text"
          ]
        }
      },
      "required": [
        "_tag"
      ],
      "additionalProperties": true
    },
    "SnapShotAccessibility": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "flat-text"
              ]
            },
            "text": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "format",
            "text",
            "truncated"
          ],
          "additionalProperties": true
        },
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "element-tree"
              ]
            },
            "coordinateSpace": {
              "type": "string",
              "enum": [
                "captured-image"
              ]
            },
            "imageSize": {
              "$ref": "#/$defs/AssetImageDimensions"
            },
            "truncated": {
              "type": "boolean"
            },
            "root": {
              "$ref": "#/$defs/SnapShotAccessibilityNode"
            }
          },
          "required": [
            "format",
            "coordinateSpace",
            "imageSize",
            "truncated",
            "root"
          ],
          "additionalProperties": true
        }
      ]
    },
    "SnapShotAccessibilityNode": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "bounds": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "object",
          "properties": {
            "active": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "busy": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "checked": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "on",
                    "off",
                    "mixed"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "editable": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "enabled": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "expanded": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "focused": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "selected": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "visible": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapShotAccessibilityNode"
          },
          "maxItems": 10000
        }
      },
      "required": [
        "role",
        "bounds",
        "children"
      ],
      "additionalProperties": true
    },
    "SnapShotSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "snap-shot"
          ]
        },
        "capturedAt": {
          "type": "string"
        },
        "appName": {
          "type": "string"
        },
        "windowTitle": {
          "type": "string"
        },
        "accessibleText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "accessibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapShotAccessibility"
            },
            {
              "type": "null"
            }
          ]
        },
        "appIdentifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "appIconDataUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "capturedAt",
        "appName",
        "windowTitle"
      ],
      "additionalProperties": true
    }
  }
}
