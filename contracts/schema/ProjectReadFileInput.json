{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProjectReadFileInput",
  "title": "ProjectReadFileInput",
  "type": "object",
  "properties": {
    "cwd": {
      "type": "string"
    },
    "relativePath": {
      "type": "string"
    },
    "allowMissing": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "cwd",
    "relativePath"
  ],
  "additionalProperties": true
}
