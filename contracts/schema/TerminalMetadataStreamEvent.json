{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TerminalMetadataStreamEvent",
  "title": "TerminalMetadataStreamEvent",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "snapshot"
          ]
        },
        "terminals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TerminalSummary"
          }
        }
      },
      "required": [
        "type",
        "terminals"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "upsert"
          ]
        },
        "terminal": {
          "$ref": "#/$defs/TerminalSummary"
        }
      },
      "required": [
        "type",
        "terminal"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "remove"
          ]
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "terminalId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "threadId",
        "terminalId"
      ],
      "additionalProperties": true
    }
  ],
  "$defs": {
    "TerminalSummary": {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "terminalId": {
          "type": "string",
          "minLength": 1
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "worktreePath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "starting",
            "running",
            "exited",
            "error"
          ]
        },
        "pid": {
          "anyOf": [
            {
              "type": "integer",
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "exitSignal": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "hasRunningSubprocess": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "maxLength": 128
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "terminalId",
        "cwd",
        "worktreePath",
        "status",
        "pid",
        "exitCode",
        "exitSignal",
        "hasRunningSubprocess",
        "label",
        "updatedAt"
      ],
      "additionalProperties": true
    }
  }
}
