<idea-plugin>
  <id>io.github.xxfast.t3code</id>
  <name>T3 Code</name>
  <vendor>xxfast</vendor>

  <dependencies>
    <plugin id="com.intellij.modules.platform"/>
    <module name="intellij.platform.jewel.foundation"/>
    <module name="intellij.platform.jewel.ui"/>
    <module name="intellij.platform.jewel.ideLafBridge"/>
    <module name="intellij.platform.jewel.markdown.core"/>
    <module name="intellij.platform.jewel.markdown.extensions.autolink"/>
    <module name="intellij.platform.jewel.markdown.extensions.gfmStrikethrough"/>
    <module name="intellij.platform.jewel.markdown.extensions.gfmTables"/>
    <module name="intellij.platform.jewel.markdown.ideLafBridgeStyling"/>
    <module name="intellij.libraries.compose.foundation.desktop"/>
    <module name="intellij.libraries.compose.runtime.desktop"/>
    <module name="intellij.libraries.skiko"/>
  </dependencies>

  <depends optional="true" config-file="t3code-terminal.xml">org.jetbrains.plugins.terminal</depends>
  <!-- JCEF left core for its own plugin in 262; 2025.3.0 has no such id and keeps it in core -->
  <depends optional="true" config-file="t3code-jcef.xml">com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow
      id="T3 Sidebar"
      anchor="left"
      icon="/icons/t3Sidebar.svg"
      factoryClass="io.github.xxfast.t3code.plugin.SidebarToolWindowFactory"/>
    <toolWindow
      id="T3 Thread Details"
      anchor="right"
      doNotActivateOnStart="true"
      icon="/icons/t3ThreadDetails.svg"
      factoryClass="io.github.xxfast.t3code.plugin.ThreadDetailsToolWindowFactory"/>
    <!-- Only with -Dt3code.open, which runIde and runHarness set: opens the T3 windows -->
    <postStartupActivity implementation="io.github.xxfast.t3code.plugin.LaunchOpen"/>
    <fileEditorProvider
      implementation="io.github.xxfast.t3code.plugin.ide.ThreadFileEditorProvider"/>
    <fileEditorProvider
      implementation="io.github.xxfast.t3code.plugin.web.T3WebViewEditorProvider"/>
    <applicationConfigurable
      parentId="tools"
      instance="io.github.xxfast.t3code.plugin.settings.T3Configurable"
      id="io.github.xxfast.t3code.settings"
      displayName="T3 Code"/>
    <editorNotificationProvider
      implementation="io.github.xxfast.t3code.plugin.ide.T3FileNotificationProvider"/>
    <notificationGroup id="T3 Code" displayType="BALLOON"/>
    <!-- Not upstream's: every provider's usage limits at a glance, the banner's body on a click -->
    <statusBarWidgetFactory
      id="T3Code.UsageLimits"
      implementation="io.github.xxfast.t3code.plugin.UsageLimitsWidgetFactory"
      order="before Position"/>
    <!-- "Report to T3 Code" in the IDE's error dialog: a prefilled GitHub issue in the browser -->
    <errorHandler implementation="io.github.xxfast.t3code.plugin.ide.T3ErrorReportSubmitter"/>
    <!-- Puts T3Code.PasteAttachment and T3Code.PasteAsText ahead of $Paste and Paste from
         History while the composer has focus -->
    <actionPromoter implementation="io.github.xxfast.t3code.plugin.actions.PasteAttachmentPromoter"/>
    <!-- Puts T3Code.UndoThreadAction ahead of $Undo in the Sidebar -->
    <actionPromoter implementation="io.github.xxfast.t3code.plugin.actions.UndoThreadPromoter"/>
    <!-- Puts T3Code.StashPrompt ahead of SaveAll while the composer has focus -->
    <actionPromoter implementation="io.github.xxfast.t3code.plugin.actions.StashPromptPromoter"/>
    <!-- Puts the T3Code.Composer.* shortcuts ahead of the IDE's while the composer has focus -->
    <actionPromoter implementation="io.github.xxfast.t3code.plugin.actions.ComposerShortcutPromoter"/>
  </extensions>

  <actions>
    <!-- The escape hatch: pages the plugin doesn't own, in the server's web UI in a JCEF tab -->
    <group id="T3Code.WebView" text="T3 Code" popup="true" icon="AllIcons.General.Web">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action
        id="T3Code.OpenWebView.Settings"
        class="io.github.xxfast.t3code.plugin.web.OpenServerSettingsWebViewAction"
        text="Server settings"
        description="Open the T3 server's settings in a T3 web view"/>
      <action
        id="T3Code.OpenWebView.Providers"
        class="io.github.xxfast.t3code.plugin.web.OpenProviderSetupWebViewAction"
        text="Provider setup"
        description="Open the T3 server's provider setup in a T3 web view"/>
      <action
        id="T3Code.OpenWebView.ScheduledTasks"
        class="io.github.xxfast.t3code.plugin.web.OpenScheduledTasksWebViewAction"
        text="Scheduled tasks"
        description="Open the T3 server's scheduled tasks in a T3 web view"/>
    </group>
    <!-- Harness only (fixture mode): throws so the error dialog and its report button show -->
    <action
      id="T3Code.ThrowTestError"
      class="io.github.xxfast.t3code.plugin.actions.ThrowTestErrorAction"
      text="Throw T3 test error"
      description="Throws an exception to try the error report button">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <!-- Not in upstream's menu: the composer's stop button and `stopThreadSession`. Registered
         for Find Action and the keymap -->
    <action
      id="T3Code.InterruptRun"
      class="io.github.xxfast.t3code.plugin.actions.InterruptRunAction"
      text="Interrupt T3 run"
      description="Interrupt the run in flight, holding the queue"
      icon="AllIcons.Actions.Suspend"/>
    <action
      id="T3Code.StopThread"
      class="io.github.xxfast.t3code.plugin.actions.StopThreadAction"
      text="Stop T3 session"
      description="Detach the thread's provider sessions"
      icon="AllIcons.Debugger.KillProcess"/>

    <!-- Upstream's thread action menu (threadActionMenu.logic.ts), its order and separators:
         the ChatView's title and a Sidebar row's context menu. Open in IDE and Open terminal
         are the plugin's own, after upstream's items. No Project settings: the plugin has none -->
    <group id="T3Code.ThreadActions" text="T3 Code Thread" popup="false">
      <action
        id="T3Code.NewThreadOnBranch"
        class="io.github.xxfast.t3code.plugin.actions.NewThreadOnBranchAction"
        text="New thread on branch"
        description="Start a thread in this project on the thread's branch and worktree"
        icon="AllIcons.General.Add"/>
      <action
        id="T3Code.TogglePin"
        class="io.github.xxfast.t3code.plugin.actions.PinThreadAction"
        text="Pin thread"
        description="Pin or unpin the thread"
        icon="AllIcons.General.Pin"/>
      <action
        id="T3Code.ToggleSettle"
        class="io.github.xxfast.t3code.plugin.actions.SettleThreadAction"
        text="Settle thread"
        description="Settle or un-settle the thread"
        icon="AllIcons.Actions.Checked"/>
      <group
        id="T3Code.Snooze"
        class="io.github.xxfast.t3code.plugin.actions.SnoozeGroup"
        text="Snooze"
        description="Take the thread out of the inbox until later"
        icon="AllIcons.Vcs.History"
        popup="true"/>
      <action
        id="T3Code.Wake"
        class="io.github.xxfast.t3code.plugin.actions.WakeThreadAction"
        text="Wake thread"
        description="Bring the snoozed thread back to the inbox now"
        icon="AllIcons.Vcs.History"/>
      <separator/>
      <action
        id="T3Code.RenameThread"
        class="io.github.xxfast.t3code.plugin.actions.RenameThreadAction"
        text="Rename thread"
        description="Give the thread a new title"
        icon="AllIcons.Actions.Edit"/>
      <action
        id="T3Code.RegenerateTitle"
        class="io.github.xxfast.t3code.plugin.actions.RegenerateTitleAction"
        text="Regenerate title"
        description="Have the server write a new title from the conversation"
        icon="AllIcons.Actions.Refresh"/>
      <action
        id="T3Code.MarkUnread"
        class="io.github.xxfast.t3code.plugin.actions.MarkUnreadAction"
        text="Mark unread"
        description="Show the thread's latest run as unseen"
        icon="AllIcons.Toolwindows.NotificationsNew"/>
      <action
        id="T3Code.FilterByProject"
        class="io.github.xxfast.t3code.plugin.actions.FilterByProjectAction"
        text="Filter by project"
        description="List only this thread's project in the Sidebar, or all of them again"
        icon="AllIcons.General.Filter"/>
      <group
        id="T3Code.AutoSettle"
        class="io.github.xxfast.t3code.plugin.actions.AutoSettleGroup"
        text="Auto-settle behavior"
        popup="true">
        <action
          id="T3Code.AutoSettleOn"
          class="io.github.xxfast.t3code.plugin.actions.AutoSettleOnAction"
          text="Enabled"
          description="Settle the thread on its own once it's done"/>
        <action
          id="T3Code.AutoSettleOff"
          class="io.github.xxfast.t3code.plugin.actions.AutoSettleOffAction"
          text="Disabled"
          description="Keep the thread in the inbox until it's settled by hand"/>
      </group>
      <separator/>
      <group
        id="T3Code.Copy"
        class="io.github.xxfast.t3code.plugin.actions.CopyGroup"
        text="Copy"
        icon="AllIcons.Actions.Copy"
        popup="true">
        <action
          id="T3Code.CopyPath"
          class="io.github.xxfast.t3code.plugin.actions.CopyPathAction"
          text="Path"
          description="Copy the thread's worktree, else its project's root"
          icon="AllIcons.Nodes.Folder"/>
        <action
          id="T3Code.CopyBranch"
          class="io.github.xxfast.t3code.plugin.actions.CopyBranchAction"
          text="Branch"
          description="Copy the thread's branch name"
          icon="AllIcons.Vcs.Branch"/>
        <action
          id="T3Code.CopyThreadId"
          class="io.github.xxfast.t3code.plugin.actions.CopyThreadIdAction"
          text="Thread ID"
          description="Copy the thread's ID"/>
      </group>
      <action
        id="T3Code.ProjectSettings"
        class="io.github.xxfast.t3code.plugin.actions.ProjectSettingsAction"
        text="Project settings"
        description="The project's name and icon"
        icon="AllIcons.General.Settings"/>
      <separator/>
      <action
        id="T3Code.ToggleArchive"
        class="io.github.xxfast.t3code.plugin.actions.ArchiveThreadAction"
        text="Archive thread"
        description="Archive or unarchive the thread"
        icon="AllIcons.FileTypes.Archive"/>
      <action
        id="T3Code.DeleteThread"
        class="io.github.xxfast.t3code.plugin.actions.DeleteThreadAction"
        text="Delete"
        description="Delete the thread and its conversation history"
        icon="AllIcons.General.Delete"/>
      <separator/>
      <action
        id="T3Code.OpenInIde"
        class="io.github.xxfast.t3code.plugin.actions.OpenInIdeAction"
        text="Open in IDE"
        description="Focus the IDE window that has the thread's checkout open, else open it in a new one"
        icon="AllIcons.Actions.MenuOpen"/>
      <!-- The thread in the server's web UI, the way to its PR review guide (no route upstream) -->
      <action
        id="T3Code.OpenWebView.Thread"
        class="io.github.xxfast.t3code.plugin.web.OpenThreadWebViewAction"
        text="Open in T3 web view"
        description="Open the thread in the server's web UI, where its PR review guide is"
        icon="AllIcons.General.Web"/>
      <!-- Plugin-only, upstream has no mute. Local to this IDE project, so read-only pairings
           keep it -->
      <separator/>
      <action
        id="T3Code.ToggleMute"
        class="io.github.xxfast.t3code.plugin.actions.MuteThreadAction"
        text="Mute notifications"
        description="Mute or unmute the thread's notification balloons in this project"/>
    </group>

    <!-- A project's menu: a right-click or Shift+F10 on a row of the Sidebar's project picker -->
    <group id="T3Code.ProjectActions" text="T3 Code Project" popup="false">
      <reference ref="T3Code.ProjectSettings"/>
    </group>

    <!-- Upstream's bulk menu (Sidebar.tsx's handleMultiSelectContextMenu), its order and no
         separators: a right-click on a row in the Sidebar's multi-selection. The labels carry
         the counts, set as the menu opens -->
    <group id="T3Code.ThreadBulkActions" text="T3 Code Threads" popup="false">
      <action
        id="T3Code.Bulk.Unpin"
        class="io.github.xxfast.t3code.plugin.actions.BulkUnpinAction"
        text="Unpin"
        description="Unpin the selected threads"
        icon="AllIcons.General.PinSelected"/>
      <action
        id="T3Code.Bulk.Settle"
        class="io.github.xxfast.t3code.plugin.actions.BulkSettleAction"
        text="Settle"
        description="Settle the selected threads"
        icon="AllIcons.Actions.Checked"/>
      <group
        id="T3Code.Bulk.Snooze"
        class="io.github.xxfast.t3code.plugin.actions.BulkSnoozeGroup"
        text="Snooze"
        description="Take the selected threads out of the inbox until later"
        icon="AllIcons.Vcs.History"
        popup="true"/>
      <action
        id="T3Code.Bulk.RegenerateTitles"
        class="io.github.xxfast.t3code.plugin.actions.BulkRegenerateTitlesAction"
        text="Regenerate titles"
        description="Have the server write new titles for the selected threads"
        icon="AllIcons.Actions.Refresh"/>
      <action
        id="T3Code.Bulk.MarkUnread"
        class="io.github.xxfast.t3code.plugin.actions.BulkMarkUnreadAction"
        text="Mark unread"
        description="Show the selected threads' latest runs as unseen"
        icon="AllIcons.Toolwindows.NotificationsNew"/>
      <action
        id="T3Code.Bulk.Delete"
        class="io.github.xxfast.t3code.plugin.actions.BulkDeleteAction"
        text="Delete"
        description="Delete the selected threads and their conversation history"
        icon="AllIcons.General.Delete"/>
    </group>

    <!-- Upstream's chat.new: the "New thread in..." picker. In the IDE's New and Generate popups,
         what mod+n opens here, rather than on the key itself -->
    <action
      id="T3Code.NewThread"
      class="io.github.xxfast.t3code.plugin.actions.NewThreadAction"
      text="T3 Thread"
      description="Start a T3 Code thread in a project"
      icon="/icons/t3Sidebar.svg">
      <add-to-group group-id="NewGroup" anchor="last"/>
      <add-to-group group-id="GenerateGroup" anchor="last"/>
    </action>

    <!-- Upstream's thread.undo: the latest settle, snooze, unpin or archive, while its notice is up -->
    <action
      id="T3Code.UndoThreadAction"
      class="io.github.xxfast.t3code.plugin.actions.UndoThreadAction"
      text="Undo T3 thread action"
      description="Undo the latest settle, snooze, unpin or archive"
      icon="AllIcons.Actions.Undo"
      use-shortcut-of="$Undo"/>

    <!-- Upstream's thread.previous, thread.next and thread.jump.1 to 9, down the Sidebar's rows.
         No default keys: upstream's mod+shift+[ and ] are code block selection here and editor
         tabs on macOS, mod+1 to 9 are bookmarks here and tool windows on macOS -->
    <action
      id="T3Code.PreviousThread"
      class="io.github.xxfast.t3code.plugin.actions.PreviousThreadAction"
      text="Previous T3 Thread"
      description="Open the thread above the open one in the T3 Sidebar"/>
    <action
      id="T3Code.NextThread"
      class="io.github.xxfast.t3code.plugin.actions.NextThreadAction"
      text="Next T3 Thread"
      description="Open the thread below the open one in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread1"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 1"
      description="Open the first thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread2"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 2"
      description="Open the second thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread3"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 3"
      description="Open the third thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread4"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 4"
      description="Open the fourth thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread5"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 5"
      description="Open the fifth thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread6"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 6"
      description="Open the sixth thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread7"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 7"
      description="Open the seventh thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread8"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 8"
      description="Open the eighth thread in the T3 Sidebar"/>
    <action
      id="T3Code.JumpToThread9"
      class="io.github.xxfast.t3code.plugin.actions.JumpToThreadAction"
      text="Jump to T3 Thread 9"
      description="Open the ninth thread in the T3 Sidebar"/>

    <!-- Paste over the composer with files or an image on the clipboard attaches them -->
    <action
      id="T3Code.PasteAttachment"
      class="io.github.xxfast.t3code.plugin.actions.PasteAttachmentAction"
      text="Paste as T3 attachment"
      description="Attach the files or image on the clipboard to the message"
      use-shortcut-of="$Paste"/>

    <!-- Upstream's composer.stash (mod+s): stash the draft, or restore or open the stash -->
    <action
      id="T3Code.StashPrompt"
      class="io.github.xxfast.t3code.plugin.actions.StashPromptAction"
      text="Stash T3 prompt"
      description="Stash the composer's draft, or restore a stashed prompt when it's empty"
      use-shortcut-of="SaveAll"/>

    <!-- Upstream's paste-as-text shortcut: the clipboard's text inline, however large -->
    <action
      id="T3Code.PasteAsText"
      class="io.github.xxfast.t3code.plugin.actions.PasteAsTextAction"
      text="Paste as Text into T3 Composer"
      description="Paste the clipboard's text inline, without folding a large paste into a file">
      <keyboard-shortcut keymap="$default" first-keystroke="control shift V"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift V"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift V"/>
    </action>

    <!-- The editor selection as context on the selected thread's draft. Claude Code's
         keys for the same; git's Commit and Push has them too, but only in the commit UI -->
    <action
      id="T3Code.AddSelectionToThread"
      class="io.github.xxfast.t3code.plugin.actions.AddSelectionToThreadAction"
      text="Add to T3 thread"
      description="Add the selection, with its path and lines, to the selected T3 thread's message">
      <add-to-group group-id="EditorPopupMenu" anchor="last"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt K"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt K"/>
    </action>

    <!-- A review comment on a T3 diff: the diff viewer's popups, its toolbar (set per request), a key -->
    <action
      id="T3Code.AddReviewComment"
      class="io.github.xxfast.t3code.plugin.review.AddReviewCommentAction"
      text="Add T3 review comment"
      description="Comment on the selected lines; the comment goes with the thread's next message"
      icon="AllIcons.General.Balloon">
      <add-to-group group-id="Diff.EditorPopupMenu" anchor="first"/>
      <add-to-group group-id="Diff.EditorGutterPopupMenu" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift C"/>
    </action>

    <!-- Upstream's composer keybindings (packages/shared/src/keybindings.ts:176 to 206) and their
         default keys, mod being Cmd on macOS. Only while the composer has focus. Effort and Mode
         deviate from upstream's keybindings.ts (mod+shift+e, mod+shift+a): those are Recent
         Locations and Find Action in the IDE keymaps, so native wins and they move -->
    <action
      id="T3Code.Composer.ModelPicker"
      class="io.github.xxfast.t3code.plugin.actions.ComposerModelPickerAction"
      text="T3 Model Picker: Toggle"
      description="Open the model picker for the focused T3 composer">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift M"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift M"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift M"/>
    </action>
    <action
      id="T3Code.Composer.Effort"
      class="io.github.xxfast.t3code.plugin.actions.ComposerEffortAction"
      text="T3 Composer: Effort"
      description="Open the focused T3 composer&apos;s effort and traits picker">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift Y"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift Y"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift Y"/>
    </action>
    <action
      id="T3Code.Composer.Mode"
      class="io.github.xxfast.t3code.plugin.actions.ComposerModeAction"
      text="T3 Composer: Mode"
      description="Open the focused T3 composer&apos;s runtime mode select">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift Y"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift Y"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift Y"/>
    </action>
    <action
      id="T3Code.Composer.Workspace"
      class="io.github.xxfast.t3code.plugin.actions.ComposerWorkspaceAction"
      text="T3 Composer: Workspace"
      description="Open the focused T3 composer&apos;s workspace select">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift X"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift X"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift X"/>
    </action>
    <action
      id="T3Code.Composer.Branch"
      class="io.github.xxfast.t3code.plugin.actions.ComposerBranchAction"
      text="T3 Composer: Branch"
      description="Open the focused T3 composer&apos;s branch picker">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift G"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift G"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift G"/>
    </action>
    <action
      id="T3Code.Composer.SteerQueued"
      class="io.github.xxfast.t3code.plugin.actions.ComposerSteerQueuedAction"
      text="T3 Queue: Send First Queued Message as Steer"
      description="Steer the first queued message into the running turn">
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift ENTER"/>
      <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta shift ENTER"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta shift ENTER"/>
    </action>
    <action
      id="T3Code.Composer.EditQueued"
      class="io.github.xxfast.t3code.plugin.actions.ComposerEditQueuedAction"
      text="T3 Queue: Edit Last Queued Message"
      description="Take the last queued message back into the composer, with the caret at the start">
      <keyboard-shortcut keymap="$default" first-keystroke="alt UP"/>
    </action>
  </actions>
</idea-plugin>
